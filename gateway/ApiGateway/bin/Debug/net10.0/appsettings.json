{
  "ReverseProxy": {
    "Routes": {
      "identity": {
        "ClusterId": "identityCluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "crop": {
        "ClusterId": "cropCluster",
        "Match": {
          "Path": "/api/crop/{**catch-all}"
        }
      },
      "order": {
        "ClusterId": "orderCluster",
        "Match": {
          "Path": "/api/order/{**catch-all}"
        }
      },
      "payment": {
        "ClusterId": "paymentCluster",
        "Match": {
          "Path": "/api/payment/{**catch-all}"
        }
      },
      "review": {
        "ClusterId": "reviewCluster",
        "Match": {
          "Path": "/api/review/{**catch-all}"
        }
      },
      "subscription": {
        "ClusterId": "subscriptionCluster",
        "Match": {
          "Path": "/api/subscription/{**catch-all}"
        }
      }
    },

    "Clusters": {
      "identityCluster": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5188/"
          }
        }
      },

      "cropCluster": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5284/"
          }
        }
      },

      "orderCluster": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5098/"
          }
        }
      },

      
      "paymentCluster": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5096/"
          }
        }
      },

      
      "reviewCluster": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5166/"
          }
        }
      },

      
      "subscriptionCluster": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5002/"
          }
        }
      }
    }
  }
}
